# Insight environment for native Windows development.
# Copy this file to .env and set DB_USERNAME and DB_PASSWORD yourself.
# This file does not contain MariaDB credentials.
#
# DB_DATABASE must stay insight. Do not point this application at inspect.
# The password belongs only in the local .env file.

APP_NAME=Insight
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Structured JSON logs.
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 10.11 through Laravel's mysql driver.
# Host development uses the server already listening on 127.0.0.1:3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insight
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Browser origins allowed to call GET /api/v1/health. Comma-separated, no wildcard.
# POST /api/v1/events allows any browser origin. It does not accept credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Events accepted per public write key and client IP, each minute.
INSIGHT_INGESTION_PER_MINUTE=60

# Client-rendered Inertia pages. A separate SSR service is not required.
INERTIA_SSR_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production must replace every local default:
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=            # unique value from `php artisan key:generate --show`
# LOG_LEVEL=info
# DB_PASSWORD=        # inject from a secret store, never from the frontend
# CORS_ALLOWED_ORIGINS=https://app.example.com
